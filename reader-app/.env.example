# Docker local mode
NEXT_PUBLIC_READER_BACKEND=local
READER_BACKEND=local
# Published ports are loopback-only unless these values are explicitly changed.
READER_BIND_ADDRESS=127.0.0.1
READER_PROXY_BIND_ADDRESS=127.0.0.1
READER_DATA_DIR=/data
READER_SESSION_DURATION_MS=2592000000
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false
READER_DOMAIN=localhost
# Set a strong random value in .env for deployments.
SESSION_SECRET=replace-with-a-long-random-value
