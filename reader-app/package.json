{
  "name": "reader-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "local:user": "node scripts/local-users.mjs",
    "local:backup": "node scripts/local-backup.mjs",
    "firebase:member": "node scripts/firebase-members.mjs",
    "test:local-api": "node tests/local-api.smoke.mjs",
