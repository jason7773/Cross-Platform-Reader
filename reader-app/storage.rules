rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function activeMember() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.active == true;
    }

    function ownsPath(userId) {
      return activeMember() && request.auth.uid == userId;
    }

    function validBookUpload() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/epub\\+zip');
    }

    function validCoverUpload() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /books/{userId}/{fileName} {
      allow read, delete: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validBookUpload();
    }

    match /covers/{userId}/{fileName} {
      allow read, delete: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validCoverUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
